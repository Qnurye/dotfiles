#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import sys
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description="Launch a configured pstack worker in the current directory.")
    parser.add_argument("role")
    parser.add_argument("brief", nargs="?", type=Path)
    parser.add_argument("--list", action="store_true", help="print this role's configured seats")
    parser.add_argument("--seat", help="select a model from this role's pool")
    args = parser.parse_args()
    settings = Path.home() / ".agents/pstack-models.md"
    try:
        source = settings.read_text()
        config = json.loads(source.split("```json\n", 1)[1].split("\n```", 1)[0])
        seats = config["roles"][args.role]
        if args.list:
            print("\n".join(seats))
            return
        model = args.seat or (seats[0] if len(seats) == 1 else None)
        if model not in seats:
            parser.error("select a seat from " + ", ".join(seats))
        if args.brief is None:
            parser.error("a brief file is required")
        command = config["commands"][model]
        search_path = os.pathsep.join([
            os.environ.get("PATH", os.defpath),
            str(Path.home() / ".local/bin"),
            "/opt/homebrew/bin",
            "/usr/local/bin",
            "/run/current-system/sw/bin",
        ])
        executable = shutil.which(command[0], path=search_path)
        if not executable:
            parser.error(f"CLI unavailable: {command[0]}")
        with args.brief.open("rb") as brief:
            if "{brief}" in command:
                prompt = brief.read().decode()
                command = [prompt if arg == "{brief}" else arg for arg in command]
                stdin = os.open(os.devnull, os.O_RDONLY)
            else:
                stdin = brief.fileno()
            os.dup2(stdin, 0)
            os.execve(executable, command, dict(os.environ, PATH=search_path))
    except (OSError, ValueError, IndexError, KeyError) as error:
        sys.exit(f"pstack-worker: {error}")


if __name__ == "__main__":
    main()
