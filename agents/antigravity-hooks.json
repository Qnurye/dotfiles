{
  "_otty": {
    "PreInvocation": [
      {
        "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' OTTY_SOCKET='/Users/qnurye/Library/Application Support/io.appmakes.otty/otty.sock' '/Applications/Otty.app/Contents/Resources/agent-integration/antigravity/otty-hook.sh' processing \"$PPID\"",
        "type": "command"
      }
    ],
    "Stop": [
      {
        "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' OTTY_SOCKET='/Users/qnurye/Library/Application Support/io.appmakes.otty/otty.sock' '/Applications/Otty.app/Contents/Resources/agent-integration/antigravity/otty-hook.sh' idle \"$PPID\"",
        "type": "command"
      }
    ]
  },
  "comment-cleanup": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/agents/hooks/clean-comments.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/agents/hooks/clean-comments.py\" post"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"$HOME/dotfiles/agents/hooks/clean-comments.py\" notify"
      }
    ]
  }
}
