# ── PATH ─────────────────────────────────────────────────────────
set-environment -g PATH "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"

# ── Prefix: Ctrl-\ ──────────────────────────────────────────────
set -gu prefix2
unbind C-a
unbind C-b
unbind C-Space
set -g prefix 'C-\'
bind 'C-\' send-prefix

# ── Oh My Tmux variables ────────────────────────────────────────
tmux_conf_new_session_retain_current_path=true
tmux_conf_new_window_retain_current_path=true
tmux_conf_copy_to_os_clipboard=true

# ── Theme (follows terminal palette — adapts to light/dark) ──────
# colour_1       = status bar bg
# colour_2       = pane border (inactive)
# colour_3       = inactive window fg / message fg
# colour_4       = accent (active window bg, active pane border)
# colour_5       = alert accent (prefix, bell)
# colour_6/7/8   = status-left fg (3 segments)
# colour_9/10/11 = status-left bg (3 segments)
# colour_12/13/14= status-right fg (3 segments)
# colour_15/16/17= status-right bg (3 segments)
tmux_conf_theme_colour_1="default"      # status bar bg → terminal bg
tmux_conf_theme_colour_2="colour8"      # pane border → bright black
tmux_conf_theme_colour_3="colour8"      # inactive window fg → muted
tmux_conf_theme_colour_4="colour4"      # accent → ANSI blue
tmux_conf_theme_colour_5="colour3"      # alert → ANSI yellow
tmux_conf_theme_colour_6="colour15"     # status-left seg1 fg (on blue bg)
tmux_conf_theme_colour_7="default"      # status-left seg2 fg
tmux_conf_theme_colour_8="default"      # status-left seg3 fg
tmux_conf_theme_colour_9="colour4"      # status-left seg1 bg (session = blue)
tmux_conf_theme_colour_10="default"     # status-left seg2 bg
tmux_conf_theme_colour_11="default"     # status-left seg3 bg
tmux_conf_theme_colour_12="colour8"     # status-right seg1 fg (muted)
tmux_conf_theme_colour_13="default"     # status-right seg2 fg
tmux_conf_theme_colour_14="default"     # status-right seg3 fg
tmux_conf_theme_colour_15="default"     # status-right seg1 bg
tmux_conf_theme_colour_16="default"     # status-right seg2 bg
tmux_conf_theme_colour_17="default"     # status-right seg3 bg

tmux_conf_theme_left_separator_main=""
tmux_conf_theme_left_separator_sub="|"
tmux_conf_theme_right_separator_main=""
tmux_conf_theme_right_separator_sub="|"

tmux_conf_theme_status_left=" #S "
tmux_conf_theme_status_right=" #{prefix} %R | %d %b | #H "
tmux_conf_theme_terminal_title="#S · #W"

# ── Terminal ─────────────────────────────────────────────────────
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-ghostty:Tc,xterm-256color:Tc,tmux-256color:Tc"
set -ag terminal-features ",xterm-ghostty:extkeys"
set -g allow-passthrough on
set -s extended-keys always
set -as terminal-features 'xterm-ghostty:clipboard:ccolour:cstyle:focus:title:extkeys'
set -g set-clipboard on

# ── Pane ─────────────────────────────────────────────────────────
set -g pane-border-lines simple
set -g pane-border-style "fg=colour8"
set -g pane-active-border-style "fg=colour4"
set -g mouse on

# ── Plugins ──────────────────────────────────────────────────────
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'wfxr/tmux-fzf-url'

set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-strategy-vim 'session'
set -g @resurrect-capture-pane-contents 'on'
set -g @prefix_highlight_show_copy_mode 'on'
set -g @tmux-fzf-launch-key 'F'
set -g @fzf-url-bind 'u'
set -g @fzf-url-open "open"

# ── Custom bindings ──────────────────────────────────────────────
bind -n M-h resize-pane -L 3
bind -n M-j resize-pane -D 3
bind -n M-k resize-pane -U 3
bind -n M-l resize-pane -R 3
bind X kill-pane
bind Z run-shell 'zed "#{pane_current_path}"'

# ── Logi Options+ mouse bindings ─────────────────────────────────
# Assign these keystrokes in Logi Options+ (Keystroke Assignment):
#   Thumbwheel scroll left  → Ctrl+Alt+Shift+Left   (previous window)
#   Thumbwheel scroll right → Ctrl+Alt+Shift+Right  (next window)
#   Forward button          → Ctrl+Alt+Shift+Up     (previous session)
#   Back button             → Ctrl+Alt+Shift+Down   (next session)
bind -n C-M-S-Left  previous-window
bind -n C-M-S-Right next-window
bind -n C-M-S-Up    switch-client -p
bind -n C-M-S-Down  switch-client -n

# ── TPM (must be last) ──────────────────────────────────────────
run '~/.tmux/plugins/tpm/tpm'
