# ── PATH ─────────────────────────────────────────────────────────
set-environment -g PATH "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"

# ── Prefix: Ctrl-\ ──────────────────────────────────────────────
set -gu prefix2
unbind C-a
unbind C-b
unbind C-Space
set -g prefix 'C-\'
bind 'C-\' send-prefix

# ── Oh My Tmux variables ────────────────────────────────────────
tmux_conf_new_session_retain_current_path=true
tmux_conf_new_window_retain_current_path=true
tmux_conf_copy_to_os_clipboard=true

# ── Theme ────────────────────────────────────────────────────────
tmux_conf_theme_colour_1="#1f2329"
tmux_conf_theme_colour_2="#2a2f38"
tmux_conf_theme_colour_3="#9aa4b2"
tmux_conf_theme_colour_4="#7aa2f7"
tmux_conf_theme_colour_5="#e5c07b"
tmux_conf_theme_colour_6="#1f2329"
tmux_conf_theme_colour_7="#d0d7de"
tmux_conf_theme_colour_8="#1f2329"
tmux_conf_theme_colour_9="#3a4150"
tmux_conf_theme_colour_10="#3a4150"
tmux_conf_theme_colour_11="#3a4150"
tmux_conf_theme_colour_12="#9aa4b2"
tmux_conf_theme_colour_13="#d0d7de"
tmux_conf_theme_colour_14="#1f2329"
tmux_conf_theme_colour_15="#1f2329"
tmux_conf_theme_colour_16="#2a2f38"
tmux_conf_theme_colour_17="#d0d7de"

tmux_conf_theme_left_separator_main=""
tmux_conf_theme_left_separator_sub="|"
tmux_conf_theme_right_separator_main=""
tmux_conf_theme_right_separator_sub="|"

tmux_conf_theme_status_left=" #S "
tmux_conf_theme_status_right=" #{prefix} %R | %d %b | #H "
tmux_conf_theme_terminal_title="#S · #W"

# ── Terminal ─────────────────────────────────────────────────────
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-ghostty:Tc,xterm-256color:Tc,tmux-256color:Tc"
set -ag terminal-features ",xterm-ghostty:extkeys"
set -g allow-passthrough on
set -s extended-keys always
set -as terminal-features 'xterm-ghostty:clipboard:ccolour:cstyle:focus:title:extkeys'
set -g set-clipboard on

# ── Pane ─────────────────────────────────────────────────────────
set -g pane-border-lines simple
set -g pane-border-style "fg=#3a4150"
set -g pane-active-border-style "fg=#7aa2f7"
set -g mouse on

# ── Plugins ──────────────────────────────────────────────────────
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'wfxr/tmux-fzf-url'

set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-strategy-vim 'session'
set -g @resurrect-capture-pane-contents 'on'
set -g @prefix_highlight_show_copy_mode 'on'
set -g @tmux-fzf-launch-key 'F'
set -g @fzf-url-bind 'u'
set -g @fzf-url-open "open"

# ── Custom bindings ──────────────────────────────────────────────
bind -n M-h resize-pane -L 3
bind -n M-j resize-pane -D 3
bind -n M-k resize-pane -U 3
bind -n M-l resize-pane -R 3
bind X kill-pane
bind Z run-shell 'zed "#{pane_current_path}"'

# ── TPM (must be last) ──────────────────────────────────────────
run '~/.tmux/plugins/tpm/tpm'
