set -l subcommands switch build check activate edit changelog

complete -c darwin-rebuild -f
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a switch -d 'Build and activate the configuration'
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a build -d 'Build without activating'
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a check -d 'Build and run activation sanity checks'
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a activate -d 'Activate the already-built configuration'
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a edit -d 'Open the configuration in $EDITOR'
complete -c darwin-rebuild -n "not __fish_seen_subcommand_from $subcommands" -a changelog -d 'Show the nix-darwin changelog'

complete -c darwin-rebuild -l flake -rF -d 'Flake to build'
complete -c darwin-rebuild -l no-flake -d 'Ignore the flake'
complete -c darwin-rebuild -l list-generations -d 'List system generations'
complete -c darwin-rebuild -l rollback -d 'Switch to the previous generation'
complete -c darwin-rebuild -s G -l switch-generation -x -d 'Switch to a generation'
complete -c darwin-rebuild -s p -l profile-name -x -d 'System profile to use'
complete -c darwin-rebuild -s j -l max-jobs -x -a auto -d 'Maximum parallel build jobs'
complete -c darwin-rebuild -l cores -x -d 'Cores per build job'
complete -c darwin-rebuild -l dry-run -d 'Show what would be built'
complete -c darwin-rebuild -s k -l keep-going -d 'Keep building after a failure'
complete -c darwin-rebuild -s K -l keep-failed -d 'Keep failed build directories'
complete -c darwin-rebuild -l fallback -d 'Build from source if substitution fails'
complete -c darwin-rebuild -l show-trace -d 'Show evaluation stack traces'
complete -c darwin-rebuild -s L -l print-build-logs -d 'Print full build logs'
complete -c darwin-rebuild -s v -l verbose -d 'Increase verbosity'
complete -c darwin-rebuild -l impure -d 'Allow impure evaluation'
complete -c darwin-rebuild -l offline -d 'Disable substituters and network access'
complete -c darwin-rebuild -l refresh -d 'Ignore cached flake fetches'
complete -c darwin-rebuild -l commit-lock-file -d 'Commit lock file changes'
complete -c darwin-rebuild -l recreate-lock-file -d 'Recreate the lock file from scratch'
complete -c darwin-rebuild -l no-update-lock-file -d 'Do not update the lock file'
complete -c darwin-rebuild -l no-write-lock-file -d 'Do not write the lock file'
complete -c darwin-rebuild -l no-registries -d 'Do not use flake registries'
complete -c darwin-rebuild -l override-input -x -d 'Override a flake input'
complete -c darwin-rebuild -l update-input -x -d 'Update a flake input'
complete -c darwin-rebuild -l option -x -d 'Set a Nix option'
complete -c darwin-rebuild -l substituters -x -d 'Substituters to use'
complete -c darwin-rebuild -l log-format -x -a 'raw internal-json bar bar-with-logs' -d 'Log output format'
