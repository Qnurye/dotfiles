# Ghostty Configuration

# ============ 字体 ============
font-family = Maple Mono NF CN
font-size = 13

# ============ 主题 ============
theme = light:Nord,dark:Atom One Dark

# ============ 光标 ============
cursor-style = bar

# ============ 背景 ============
background-opacity = 0.9
background-blur = true

# ============ 窗口 ============
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-vsync = true
window-inherit-working-directory = true
window-save-state = always

# ============ 滚动 ============
scrollback-limit = 100000000
mouse-scroll-multiplier = precision:2,discrete:3

# ============ 复制/选择 ============
copy-on-select = true

# ============ Shell 集成 ============
shell-integration = detect
confirm-close-surface = false
command = /opt/homebrew/bin/tmux new -A -s main

# ============ macOS ============
macos-titlebar-style = transparent
macos-option-as-alt = right
macos-window-shadow = true

# ============ Quick Terminal (下拉式终端) ============
# 全局快捷键: Ctrl+` 任何地方秒开终端 (需要授予辅助功能权限)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

# ============ 链接 ============
link-url = true

# ============ tmux ============
# 让 Ghostty 的 shell integration 正确穿透 tmux
shell-integration-features = cursor,sudo,title

# ============ tmux Cmd 快捷键 (prefix = Ctrl-\ = 0x1c) ============
# Cmd+T → 新窗口 (prefix + c)
keybind = super+t=text:\x1c\x63
# Cmd+W → 关闭 pane (prefix + X, 无确认)
keybind = super+w=text:\x1c\x58
# Cmd+Z → zoom toggle (prefix + z)
keybind = super+z=text:\x1c\x7a
# Cmd+1~9 → 切换 tmux 窗口 (用 digit_N 覆盖 Ghostty 默认的 goto_tab)
keybind = super+digit_1=text:\x1c\x31
keybind = super+digit_2=text:\x1c\x32
keybind = super+digit_3=text:\x1c\x33
keybind = super+digit_4=text:\x1c\x34
keybind = super+digit_5=text:\x1c\x35
keybind = super+digit_6=text:\x1c\x36
keybind = super+digit_7=text:\x1c\x37
keybind = super+digit_8=text:\x1c\x38
keybind = super+digit_9=text:\x1c\x39
# Cmd+[ / ] → 前/后窗口 (prefix + p / n)
keybind = super+left_bracket=text:\x1c\x70
keybind = super+right_bracket=text:\x1c\x6e
# Cmd+D → 水平分屏 (prefix + -)
keybind = super+d=text:\x1c\x2d
# Cmd+Shift+D → 垂直分屏 (prefix + |) — 用 _ 因为 oh-my-tmux 绑定
keybind = super+shift+d=text:\x1c\x5f

# ============ macOS 编辑快捷键 ============
# Cmd+Left → Home (行首)
keybind = super+left=text:\x01
# Cmd+Right → End (行尾)
keybind = super+right=text:\x05
# Cmd+Backspace → 删除到行首 (Ctrl-U)
keybind = super+backspace=text:\x15
# Alt+Left → 前一个词 (ESC+b)
keybind = alt+left=text:\x1bb
# Alt+Right → 后一个词 (ESC+f)
keybind = alt+right=text:\x1bf
# Alt+Backspace → 删除前一个词 (Ctrl-W)
keybind = alt+backspace=text:\x17

# ============ Claude Code 换行修复 ============
# Shift+Enter → 发送换行符 (绕过 tmux extended-keys 问题)
keybind = shift+enter=text:\x0a
