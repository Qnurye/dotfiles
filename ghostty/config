# Ghostty Configuration

# ============ 字体 ============
font-family = Maple Mono NF CN
font-size = 13

# ============ 主题 ============
theme = light:Nord,dark:Atom One Dark

# ============ 光标 ============
cursor-style = bar

# ============ 背景 ============
background-opacity = 0.9
background-blur = true

# ============ 窗口 ============
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
window-vsync = true
window-inherit-working-directory = true
window-save-state = always

# ============ 滚动 ============
scrollback-limit = 100000000
mouse-scroll-multiplier = precision:2,discrete:3

# ============ 复制/选择 ============
copy-on-select = true

# ============ Shell 集成 ============
shell-integration = detect
confirm-close-surface = false
command = /opt/homebrew/bin/tmux new -A -s main

# ============ macOS ============
macos-titlebar-style = hidden
macos-option-as-alt = right
macos-window-shadow = true

# ============ Quick Terminal (下拉式终端) ============
# 全局快捷键: Ctrl+` 任何地方秒开终端 (需要授予辅助功能权限)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

# ============ 链接 ============
link-url = true

# ============ tmux ============
# 让 Ghostty 的 shell integration 正确穿透 tmux
shell-integration-features = cursor,sudo,title

# ============ tmux Cmd 快捷键 (prefix = Ctrl-Space = 0x00) ============
# Cmd+T → 新窗口 (prefix + c)
keybind = super+t=text:\x00\x63
# Cmd+W → 关闭 pane (prefix + x)
keybind = super+w=text:\x00\x78
# Cmd+Z → zoom toggle (prefix + z)
keybind = super+z=text:\x00\x7a
# Cmd+1~9 → 切换 tmux 窗口
keybind = super+one=text:\x00\x31
keybind = super+two=text:\x00\x32
keybind = super+three=text:\x00\x33
keybind = super+four=text:\x00\x34
keybind = super+five=text:\x00\x35
keybind = super+six=text:\x00\x36
keybind = super+seven=text:\x00\x37
keybind = super+eight=text:\x00\x38
keybind = super+nine=text:\x00\x39
# Cmd+Shift+[ / ] → 前/后窗口 (prefix + p / n)
keybind = super+shift+left_bracket=text:\x00\x70
keybind = super+shift+right_bracket=text:\x00\x6e
# Cmd+D → 水平分屏 (prefix + -)
keybind = super+d=text:\x00\x2d
# Cmd+Shift+D → 垂直分屏 (prefix + |) — 用 _ 因为 oh-my-tmux 绑定
keybind = super+shift+d=text:\x00\x5f

# ============ macOS 编辑快捷键 ============
# Cmd+Left → Home (行首)
keybind = super+left=text:\x01
# Cmd+Right → End (行尾)
keybind = super+right=text:\x05
# Cmd+Backspace → 删除到行首 (Ctrl-U)
keybind = super+backspace=text:\x15
# Alt+Left → 前一个词 (ESC+b)
keybind = alt+left=text:\x1bb
# Alt+Right → 后一个词 (ESC+f)
keybind = alt+right=text:\x1bf
# Alt+Backspace → 删除前一个词 (Ctrl-W)
keybind = alt+backspace=text:\x17
